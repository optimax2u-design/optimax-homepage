---
pagination:
  data: legalPages
  size: 1
  alias: L
permalink: "/{{ L.slug }}/"
layout: layouts/base.njk
hide_booking: true
eleventyComputed:
  title: "{{ pages[L.slug].title }}"
  description: "{{ pages[L.slug].description }}"
---
{#- Privacy Policy / Terms of Use — content word-for-word from the live pages -#}
{%- import "macros.njk" as m -%}
{%- set P = pages[L.slug] -%}

{{ m.phero({title: L.title}, [{label: L.title}]) }}

<section class="section section--flush">
  <div class="wrap legal">
    <nav class="legal__toc" aria-label="On this page">
      {%- for t in P.toc %}<a href="#s{{ loop.index }}">{{ t }}</a>{% endfor %}
    </nav>
    <article class="prose">
      <h2>{{ P.heading }}</h2>
      {{ m.items(P.items) }}
    </article>
  </div>
</section>
