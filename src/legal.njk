---
pagination:
  data: legal
  size: 1
  alias: doc
  resolve: values
permalink: "/{{ doc.slug }}/"
layout: layouts/base.njk
hide_booking: true
eleventyComputed:
  title: "{{ doc.title }} | Optimax Eye Specialist"
  description: "{{ doc.seo_description }}"
---
{%- import "macros.njk" as m -%}

{{ m.phero({eyebrow: "Legal", title: doc.title, subhead: doc.intro}, { compact: true, crumbs: [{label: doc.title}] }) }}

<section class="section section--flush">
  <div class="wrap legal">
    <nav class="legal__toc" aria-label="On this page">
      <p class="faqs__navtitle">On this page</p>
      {%- for s in doc.sections %}<a href="#s{{ loop.index }}">{{ s.title }}</a>{% endfor %}
    </nav>
    <article class="prose">
      <p class="prose__meta">Last updated: {{ doc.updated }}</p>
      {%- for s in doc.sections %}
      <h2 id="s{{ loop.index }}">{{ s.title }}</h2>
      {{ s.body | safe }}
      {%- endfor %}
    </article>
  </div>
</section>
