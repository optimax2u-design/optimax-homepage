---
pagination:
  data: doctors.list
  size: 1
  alias: d
permalink: "/doctor/{{ d.slug }}/"
layout: layouts/base.njk
nav_key: Doctors
hide_booking: true
eleventyComputed:
  title: "{{ d.seo_title }}"
  description: "{{ d.seo_description }}"
---
{#- Doctor profile — same fields and wording as the live profile page -#}
{%- import "macros.njk" as m -%}

<section class="phero">
  <div class="wrap">{{ m.crumbs([{label: "Doctors", url: "/doctor/"}, {label: d.name}]) }}</div>
  <div class="wrap profile">
    <div class="profile__photo doc__photo c-{{ d.color }} load" style="--d:1">
      <img src="{{ d.photo }}" alt="{{ d.name }}" width="600" height="750" fetchpriority="high">
    </div>
    <div class="profile__copy">
      <h1 class="phero__title phero__title--name load" style="--d:1">{{ d.name }}</h1>
      <dl class="profile__facts load" style="--d:2">
        <div><dt>POSITION</dt><dd>{% for p in d.position %}<span class="line">{{ p }}</span>{% endfor %}</dd></div>
        <div><dt>QUALIFICATIONS</dt><dd>{{ d.credentials }}</dd></div>
        <div><dt>SPECIALTIES</dt><dd><ul class="bullets">{% for s in d.specialties %}<li>{{ s }}</li>{% endfor %}</ul></dd></div>
        <div><dt>LANGUAGE(S)</dt><dd>{{ d.languages_text }}</dd></div>
        <div><dt>BRANCH</dt><dd class="chips">{% set names = d.branch_text.split(', ') %}{% for s in d.branches %}<a href="/branches/{{ s }}/" class="pill pill--link">{{ names[loop.index0] or s }}</a>{% endfor %}</dd></div>
      </dl>
    </div>
  </div>
</section>
