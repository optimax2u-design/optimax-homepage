---
pagination:
  data: branchList
  size: 1
  alias: b
permalink: "/branches/{{ b.slug }}/"
layout: layouts/base.njk
nav_key: Branches
hide_booking: true
eleventyComputed:
  title: "{{ b.title }}"
  description: "{{ b.description }}"
---
{#- Branch page — same layout logic and wording as the live branch pages:
    "OPTIMAX Branches" list of all locations + the selected branch's details. -#}
{%- import "macros.njk" as m -%}
{%- set tel = (b.contacts | selectattr("label", "equalto", "Tel") | first) -%}

{{ m.phero({title: branches.heading, sub: [branches.intro]}, [{label: "Branches", url: "/branches/taman-tun-dr-ismail-kuala-lumpur-hq/"}, {label: b.label}]) }}

<section class="section section--flush">
  <div class="wrap branch">
    <article class="branch__card reveal" id="details">
      <h2 class="h2">{{ b.heading }}</h2>
      <p class="branch__addr">{% for l in b.address %}{{ l }}{% if not loop.last %}<br>{% endif %}{% endfor %}</p>
      <dl class="branch__contacts">
        {%- for c in b.contacts %}
        <div><dt>{{ c.label }}:</dt><dd>
          {%- if c.label == 'Tel' or c.label == 'Fax' %}<a href="{{ c.value | tel }}">{{ c.value }}</a>
          {%- elif 'WhatsApp' in c.label %}<a href="{{ c.value | wa }}" target="_blank" rel="noopener">{{ c.value }}</a>
          {%- elif 'mail' in c.label %}<a href="mailto:{{ c.value }}">{{ c.value }}</a>
          {%- else %}{{ c.value }}{% endif %}</dd></div>
        {%- endfor %}
      </dl>
      {%- if b.hours.length %}
      <h3 class="h3">Business Hours:</h3>
      <ul class="branch__hours">{% for h in b.hours %}<li>{{ h }}</li>{% endfor %}</ul>
      {%- endif %}
      <div class="ctas">
        {%- if tel %}<a class="btn btn--primary" href="{{ tel.value | tel }}">CALL NOW</a>{% endif %}
        {%- if b.google_profile %}<a class="btn btn--ghost" href="{{ b.google_profile }}" target="_blank" rel="noopener">Google Business Profile</a>{% endif %}
        {%- if b.waze %}<a class="btn btn--ghost" href="{{ b.waze }}" target="_blank" rel="noopener">WAZE</a>{% endif %}
      </div>
    </article>

    <nav class="branch__list reveal" aria-label="All branches">
      {%- for r in branches.regions %}
      <h2 class="branch__region">{{ r.region }}</h2>
      <ul>{% for x in r.branches %}<li><a href="/branches/{{ x.slug }}/#details"{% if x.slug == b.slug %} aria-current="page"{% endif %}>{{ x.label }}</a></li>{% endfor %}</ul>
      {%- endfor %}
    </nav>
  </div>
</section>
