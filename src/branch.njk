---
pagination:
  data: branchList
  size: 1
  alias: b
permalink: "/branches/{{ b.slug }}/"
layout: layouts/base.njk
nav_key: Branches
eleventyComputed:
  title: "{{ b.full_name }} — Eye Specialist | Optimax"
  description: "{{ b.full_name }}: {{ b.address }}. Tel {{ b.tel }}. LASIK assessments, cataract care and eye screening."
  book_branch: "{{ b.name }}"
  book_title: "Book at {{ b.name }}."
---
{%- import "macros.njk" as m -%}
{%- set docs = b.slug | doctorsAt(doctors) -%}
{%- set mapsUrl = "https://www.google.com/maps/search/?api=1&query=" + (("Optimax " + b.address) | urlencode) -%}

<section class="phero phero--compact">
  <div class="wrap branch">
    <div class="branch__copy">
      {{ m.crumbs([{label: "Branches", url: "/branches/"}, {label: b.name}]) }}
      <p class="eyebrow load" style="--d:0">{{ b.region }}{% if b.area and b.area != b.region %} · {{ b.area }}{% endif %}</p>
      <h1 class="phero__title phero__title--name load" style="--d:1">{{ b.full_name }}</h1>
      <p class="phero__sub load" style="--d:2">{{ b.address }}</p>
      {%- if b.note %}<p class="branch__note load" style="--d:2">{{ b.note }}</p>{% endif %}
      <div class="hero__ctas load" style="--d:3">
        <a href="#book" class="btn btn--primary btn--lg">Book at this branch</a>
        <a href="{{ b.google_profile or mapsUrl }}" class="btn btn--ghost btn--lg" target="_blank" rel="noopener">Get directions <span aria-hidden="true">↗</span></a>
      </div>
    </div>
    <div class="branch__map load" style="--d:2">
      <iframe title="Map showing {{ b.full_name }}" src="https://maps.google.com/maps?q={{ ('Optimax ' + b.address) | urlencode }}&z=15&output=embed" loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
    </div>
  </div>
</section>

<section class="section section--flush">
  <div class="wrap info">
    <a class="info__tile c-violet reveal" href="{{ b.tel | tel }}"><span class="info__k">Call</span><span class="info__v">{{ b.tel }}</span></a>
    <a class="info__tile c-mint reveal" style="--d:1" href="{{ b.whatsapp | wa }}" target="_blank" rel="noopener"><span class="info__k">WhatsApp{% if b.slug == 'cambodia' %} / Telegram{% endif %}</span><span class="info__v">{{ b.whatsapp }}</span></a>
    <a class="info__tile c-sky reveal" style="--d:2" href="mailto:{{ b.email }}"><span class="info__k">Email</span><span class="info__v info__v--sm">{{ b.email }}</span></a>
    <div class="info__tile c-yellow reveal" style="--d:3"><span class="info__k">Opening hours</span>
      {%- if b.hours.length %}<ul class="info__hours">{% for h in b.hours %}<li>{{ h }}</li>{% endfor %}</ul>{% else %}<span class="info__v info__v--sm">Please call to confirm</span>{% endif %}
    </div>
  </div>
  <div class="wrap">
    <p class="fine reveal">Hotline {{ site.topbar.hotline }}{% if b.fax %} · Fax {{ b.fax }}{% endif %}{% if b.waze %} · <a href="{{ b.waze }}" target="_blank" rel="noopener">Open in Waze</a>{% endif %} · Public holiday hours may differ — please call ahead.</p>
  </div>
</section>

<section class="section section--tint">
  <div class="wrap split">
    <div class="reveal">
      <p class="eyebrow">At this branch</p>
      <h2 class="h2">How we can help.</h2>
      <p class="lead">{{ b.services }}. Not sure where to start? Book a free eye check and our team will guide you.</p>
      <a class="textlink" href="/treatments/">Explore treatments <span aria-hidden="true">→</span></a>
    </div>
    <div class="feat c-violet reveal" style="--d:1">
      <h3>Treatments we offer</h3>
      <ul class="tags tags--solid">
        {%- for t in treatments.list %}{% if t.slug != 'flacs' or b.slug == 'kuching' %}<li><a href="/{{ t.slug }}/">{{ t.short }}</a></li>{% endif %}{% endfor %}
      </ul>
      <p class="fine">Some procedures are performed at selected centres. We'll confirm where your treatment takes place.</p>
    </div>
  </div>
</section>

{%- if docs.length %}
<section class="section">
  <div class="wrap">
    <header class="head reveal">
      <p class="eyebrow">Your specialists</p>
      <h2>Doctors at {{ b.name }}.</h2>
    </header>
    <div class="dgrid dgrid--{{ 'few' if docs.length < 3 else 'many' }}">
      {%- for d in docs %}{{ m.doccard(d) }}{% endfor %}
    </div>
  </div>
</section>
{%- endif %}

{#- Nearby branches in the same region -#}
<section class="section{{ ' section--tint' if docs.length }}">
  <div class="wrap">
    <header class="head head--row reveal">
      <div><p class="eyebrow">Also in {{ b.region }}</p><h2>Other branches nearby.</h2></div>
      <a class="textlink textlink--top" href="/branches/">All branches <span aria-hidden="true">→</span></a>
    </header>
    <div class="bgrid">
      {%- for o in b | nearby(branchList) %}
      <a class="bcard reveal" href="/branches/{{ o.slug }}/" style="--d:{{ loop.index0 }}"><span class="bcard__region">{{ o.area or o.region }}</span><strong class="bcard__name">{{ o.full_name }}</strong><span class="bcard__addr">{{ o.address }}</span><span class="bcard__meta"><span>☎ {{ o.tel }}</span></span><span class="bcard__go" aria-hidden="true">→</span></a>
      {%- endfor %}
    </div>
  </div>
</section>
