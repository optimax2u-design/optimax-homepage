---
permalink: /treatments/
layout: layouts/base.njk
nav_key: Treatments
form: general
cta_page: treatments
eleventyComputed:
  title: "{{ pages.treatments.title }}"
  description: "{{ pages.treatments.description }}"
---
{#- Treatments overview — content word-for-word from optimaxeyespecialist.com/treatments/ (src/_data/pages/treatments.json) -#}
{%- import "macros.njk" as m -%}
{%- set P = pages.treatments -%}

{{ m.phero({title: P.hero.title, sub: P.hero.sub, buttons: P.hero.buttons, image: P.hero.images[0]}, [{label: "Treatments"}]) }}

{%- for s in P.sections %}
{%- if s.kind == 'generic' %}
{{ m.textSection(s.heading, s.items, loop.index0 % 2 == 0) }}

{%- elif s.kind == 'twolists' %}
<section class="section{{ ' section--tint' if loop.index0 % 2 == 0 }}">
  <div class="wrap">
    <header class="head reveal"><h2 class="h2">{{ s.heading }}</h2></header>
    <div class="pair">
      {%- for g in s.groups %}
      <div class="pair__card {{ 'pair__card--yes' if loop.first else 'pair__card--no' }} reveal" style="--d:{{ loop.index0 }}">
        <h3 class="h3">{{ g.label }}</h3>
        <ul class="bullets">{% for li in g.items %}<li>{{ li }}</li>{% endfor %}</ul>
      </div>
      {%- endfor %}
    </div>
    {%- for p in s.note %}<p class="note">{{ p }}</p>{% endfor %}
    {%- if s.btn %}<p class="center"><a class="btn btn--primary btn--lg" href="#book">{{ s.btn.label }}</a></p>{% endif %}
  </div>
</section>

{%- elif s.kind == 'tcards' %}
<section class="section{{ ' section--tint' if loop.index0 % 2 == 0 }}" id="all">
  <div class="wrap">
    <header class="head reveal">
      <h2 class="h2">{{ s.heading }}</h2>
      {%- for p in s.intro %}<p class="lead">{{ p }}</p>{% endfor %}
    </header>
    <div class="tcards">
      {%- for c in s.cards %}
      <a class="tcard reveal" href="{{ c.href | fixHref }}" style="--d:{{ loop.index0 % 3 }}">
        <figure class="tcard__img"><img src="{{ c.image }}" alt="{{ c.name }}" width="600" height="400" loading="lazy" decoding="async"></figure>
        <div class="tcard__body">
          <h3 class="tcard__name">{{ c.name }}</h3>
          <p class="tcard__tag">{{ c.tagline }}</p>
          {%- if c.best.length %}<p class="tcard__label">{{ c.best_label }}</p><ul class="bullets bullets--sm">{% for b in c.best %}<li>{{ b }}</li>{% endfor %}</ul>{% endif %}
          {%- for x in c.extra %}<p class="tcard__age">{{ x }}</p>{% endfor %}
          <span class="tcard__more">{{ c.btn or 'Learn More' }} <span aria-hidden="true">→</span></span>
        </div>
      </a>
      {%- endfor %}
    </div>
  </div>
</section>
{%- endif %}
{%- endfor %}
