---
pagination:
  data: blog.posts
  size: 1
  alias: p
permalink: "/{{ p.slug }}/"
layout: layouts/base.njk
nav_key: Blog
hide_booking: true
eleventyComputed:
  title: "{{ p.seo_title }}"
  description: "{{ p.seo_description }}"
---
{#- Blog article — body copied word-for-word from the live article -#}
{%- import "macros.njk" as m -%}

<section class="phero phero--text">
  <div class="wrap wrap--narrow">
    {{ m.crumbs([{label: "Blog", url: "/blog/"}, {label: p.title}]) }}
    <p class="post__meta load" style="--d:0">{% for c in p.categories %}<span class="post__cat">{{ c }}</span>{% endfor %}<time datetime="{{ p.date }}">{{ p.date | niceDate }}</time></p>
    <h1 class="phero__title phero__title--post load" style="--d:1">{{ p.title }}</h1>
    {%- if p.image %}<figure class="post__hero load" style="--d:2"><img src="{{ p.image }}" alt="{{ p.title }}" width="1200" height="800" fetchpriority="high"></figure>{% endif %}
  </div>
</section>

<section class="section section--flush">
  <div class="wrap wrap--narrow">
    <article class="prose prose--post">{{ p.body | fixLinks | safe }}</article>
  </div>
</section>
