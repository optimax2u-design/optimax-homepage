---
permalink: /doctor/
layout: layouts/base.njk
hide_booking: true
title: "Optimax Eye Specialists | Ophthalmologists in Malaysia"
description: "Meet Optimax's ophthalmologists — experts in LASIK, SMILE, cataract & vision correction across Malaysia."
---
{#- Doctors list — same doctors, wording and filters as optimaxeyespecialist.com/doctor/ -#}
{%- import "macros.njk" as m -%}
{%- set F = doctors.filters -%}

{{ m.phero({title: "Doctors"}, [{label: "Doctors"}]) }}

<section class="section section--flush">
  <div class="wrap">
    <div class="filters reveal">
      <div class="filters__row">
        <label for="flt-branch" class="filters__label">Branch</label>
        <select id="flt-branch" data-filter="branch">
          <option value="">{{ F.branch_placeholder }}</option>
          {%- for b in F.branches %}<option value="{{ b.slug }}">{{ b.label }} ({{ (b.slug | doctorsAt(doctors)).length }})</option>{% endfor %}
        </select>
      </div>
      <div class="filters__row">
        <label for="flt-lang" class="filters__label">Language</label>
        <select id="flt-lang" data-filter="lang">
          <option value="">{{ F.language_placeholder }}</option>
          {%- for l in F.languages %}<option value="{{ l }}">{{ l }} ({{ (doctors.list | selectattr('languages') | langCount(l)) }})</option>{% endfor %}
        </select>
      </div>
      <p class="filters__count" aria-live="polite">Show (<span data-count>{{ doctors.list.length }}</span>)</p>
    </div>

    <div class="dgrid" data-filter-list>
      {%- for d in doctors.list %}{{ m.doccard(d) }}{% endfor %}
    </div>
    <p class="empty" data-empty hidden>No doctors match. <button type="button" class="linkbtn" data-reset>Cancel</button></p>
  </div>
</section>
