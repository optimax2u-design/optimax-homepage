---
pagination:
  data: treatments.list
  size: 1
  alias: t
permalink: "/{{ t.slug }}/"
layout: layouts/base.njk
nav_key: Treatments
eleventyComputed:
  title: "{{ t.seo_title }}"
  description: "{{ t.seo_description }}"
  book_service: "{{ t.service }}"
  book_title: "Book your {{ t.short }} consultation."
---
{%- import "macros.njk" as m -%}

{{ m.phero(t.hero, {
  color: t.color, image: t.image, image_alt: t.image_alt,
  badge_number: t.hero.badge_number, badge_label: t.hero.badge_label,
  crumbs: [{label: "Treatments", url: "/treatments/"}, {label: t.short}],
  ctas: [{label: "Check if I'm suitable — free", url: "#book"}, {label: "Ask on WhatsApp", url: site.topbar.whatsapp_link, style: "ghost", external: true}]
}) }}

{{ m.tiles(t.facts) }}

{#- What is it -#}
<section class="section">
  <div class="wrap split">
    <div class="reveal">
      <p class="eyebrow">How it works</p>
      <h2 class="h2">{{ t.what.title }}</h2>
      <p class="lead">{{ t.what.text }}</p>
    </div>
    <div class="feat c-{{ t.color }} reveal" style="--d:1">
      <h3>Key features</h3>
      <ul class="checks">{% for f in t.what.features %}<li>{{ f }}</li>{% endfor %}</ul>
    </div>
  </div>
</section>

{#- Who it suits -#}
<section class="section section--tint">
  <div class="wrap">
    <header class="head reveal">
      <p class="eyebrow">Is it right for me?</p>
      <h2>Who it's for.</h2>
    </header>
    <div class="suit suit--wide">
      <div class="suit__card suit__card--yes reveal">
        <h3><span aria-hidden="true">✓</span> Often a good fit if you have</h3>
        <ul class="checks">{% for s in t.suits %}<li>{{ s }}</li>{% endfor %}</ul>
      </div>
      <div class="suit__card suit__card--no reveal" style="--d:1">
        <h3><span aria-hidden="true">✕</span> May not be suitable if you have</h3>
        <ul class="crosses">{% for s in t.not_suits %}<li>{{ s }}</li>{% endfor %}</ul>
        {%- if t.not_suits_note %}<p class="suit__note">{{ t.not_suits_note }}</p>{% endif %}
      </div>
    </div>
    <p class="fine reveal">Suitability can only be confirmed after a full eye assessment and consultation with your eye specialist.</p>
  </div>
</section>

{#- Comparison -#}
{%- if t.compare %}
<section class="section">
  <div class="wrap">
    <header class="head reveal">
      <p class="eyebrow">Compare</p>
      <h2>{{ t.compare.title }}</h2>
    </header>
    <div class="ctable ctable--hl reveal" role="region" aria-label="{{ t.compare.title }}" tabindex="0">
      <table>
        <thead><tr><th scope="col"><span class="sr">Feature</span></th>{% for c in t.compare.columns %}<th scope="col"{% if loop.first %} class="is-hl"{% endif %}>{{ c }}</th>{% endfor %}</tr></thead>
        <tbody>
          {%- for r in t.compare.rows %}
          <tr><th scope="row">{{ r.label }}</th>{% for v in r.values %}<td{% if loop.first %} class="is-hl"{% endif %}>{{ v }}</td>{% endfor %}</tr>
          {%- endfor %}
        </tbody>
      </table>
    </div>
  </div>
</section>
{%- endif %}

{#- Procedure steps -#}
<section class="section section--tint">
  <div class="wrap">
    <header class="head reveal">
      <p class="eyebrow">The procedure</p>
      <h2>{{ t.steps.title }}</h2>
      {%- if t.steps.note %}<p class="lead">{{ t.steps.note }}</p>{% endif %}
    </header>
    <ol class="steps">
      {%- set jc = ['violet','yellow','coral','mint'] %}
      {%- for s in t.steps.items %}
      <li class="step reveal" style="--d:{{ loop.index0 }}">
        {%- if s.image %}<div class="step__img"><img src="{{ s.image }}" alt="" width="600" height="450" loading="lazy" decoding="async" onerror="this.parentNode.remove()"></div>{% endif %}
        <span class="journey__n c-{{ jc[loop.index0 % 4] }}">{{ loop.index }}</span>
        <h3>{{ s.title }}</h3>
        <p>{{ s.text }}</p>
      </li>
      {%- endfor %}
    </ol>
  </div>
</section>

{#- Lens options (cataract) -#}
{%- if t.lenses %}
<section class="section">
  <div class="wrap">
    <header class="head reveal">
      <p class="eyebrow">Lens options</p>
      <h2>{{ t.lenses.title }}</h2>
      <p class="lead">{{ t.lenses.intro }}</p>
    </header>
    <div class="icards icards--3">
      {%- for l in t.lenses.items %}
      <article class="icard c-{{ l.color }} reveal" style="--d:{{ loop.index0 }}"><span class="icard__emoji" aria-hidden="true">👁️</span><h3>{{ l.title }}</h3><p>{{ l.text }}</p></article>
      {%- endfor %}
    </div>
  </div>
</section>
{%- endif %}

{#- Before & after -#}
<section class="section">
  <div class="wrap">
    <header class="head reveal">
      <p class="eyebrow">Before & after</p>
      <h2>What to expect.</h2>
    </header>
    <div class="care">
      <div class="care__card c-sky reveal"><h3><span aria-hidden="true">🗓️</span> Before treatment</h3><ul class="checks">{% for c in t.care.before %}<li>{{ c }}</li>{% endfor %}</ul></div>
      <div class="care__card c-mint reveal" style="--d:1"><h3><span aria-hidden="true">🌿</span> After treatment</h3><ul class="checks">{% for c in t.care.after %}<li>{{ c }}</li>{% endfor %}</ul></div>
    </div>
  </div>
</section>

{#- Journey (shared with homepage) -#}
<section class="section section--tint">
  <div class="wrap">
    <header class="head reveal">
      <p class="eyebrow">{{ home.journey.eyebrow }}</p>
      <h2>{{ home.journey.title }}</h2>
    </header>
    <ol class="journey">
      {%- set jc = ['violet','yellow','coral','mint'] %}
      {%- for s in home.journey.steps %}
      <li class="journey__step reveal" style="--d:{{ loop.index0 }}"><span class="journey__n c-{{ jc[loop.index0 % 4] }}">{{ loop.index }}</span><h3>{{ s.title }}</h3><p>{{ s.text }}</p></li>
      {%- endfor %}
    </ol>
  </div>
</section>

{{ m.reviewsBand(home.reviews, site) }}

{#- Other treatments -#}
<section class="section">
  <div class="wrap">
    <header class="head head--row reveal">
      <div>
        <p class="eyebrow">Keep exploring</p>
        <h2>Other treatments.</h2>
      </div>
      <a class="textlink textlink--top" href="/treatments/">Compare all <span aria-hidden="true">→</span></a>
    </header>
    <div class="tcards tcards--scroll" data-carousel>
      {%- for o in treatments.list | except("slug", t.slug) %}{% if loop.index <= 4 %}{{ m.tcard(o) }}{% endif %}{% endfor %}
    </div>
  </div>
</section>
