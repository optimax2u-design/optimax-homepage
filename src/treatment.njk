---
pagination:
  data: treatments.list
  size: 1
  alias: t
permalink: "/{{ t.slug }}/"
layout: layouts/base.njk
nav_key: Treatments
form: lasik
eleventyComputed:
  title: "{{ pages[t.slug].title }}"
  description: "{{ pages[t.slug].description }}"
  book_service: "{{ t.service }}"
  cta_page: "{{ t.slug }}"
---
{#- Treatment page. All text and images come word-for-word from the live page (src/_data/pages/<slug>.json),
    in the same order. Section types: intro, feature, suitpair, compare, steps, prepost, journey, why,
    awards, quotes, cards, generic, cta (cta = the booking section at the bottom). -#}
{%- import "macros.njk" as m -%}
{%- set P = pages[t.slug] -%}
{%- set about = pages.about -%}

{{ m.phero({title: P.hero.title, sub: P.hero.sub, image: P.hero.image, image_alt: P.hero.image_alt, buttons: [{label: "BOOK APPOINTMENT", href: "#book"}]}, [{label: "Treatments", url: "/treatments/"}, {label: t.menu}]) }}

{%- set tint = cycler(false, true) %}
{%- for s in P.sections %}
{%- if s.kind == 'cta' %}{# rendered by the booking section below #}

{%- elif s.kind == 'intro' or s.kind == 'feature' or s.kind == 'why' or s.kind == 'generic' %}
<section class="section{{ ' section--tint' if tint.next() }}">
  {%- set img = s.image or (s.items | firstImage) %}
  <div class="wrap{{ ' split split--media' if img }}">
    <div class="prose-block reveal">
      <h2 class="h2">{{ s.heading | nl2br | safe }}</h2>
      {{ m.items(s.items, {noImages: true}) }}
    </div>
    {%- if img %}<div class="side-media reveal" style="--d:1"><figure class="fig fig--card"><img src="{{ img }}" alt="{{ s.image_alt or '' }}" loading="lazy" decoding="async"></figure></div>{% endif %}
  </div>
</section>

{%- elif s.kind == 'suitpair' %}
<section class="section{{ ' section--tint' if tint.next() }}">
  <div class="wrap pair">
    {%- for side in [s.yes, s.no] %}
    <div class="pair__card {{ 'pair__card--yes' if loop.first else 'pair__card--no' }} reveal" style="--d:{{ loop.index0 }}">
      <h2 class="h3">{{ side.heading }}</h2>
      {{ m.items(side.items) }}
    </div>
    {%- endfor %}
  </div>
</section>

{%- elif s.kind == 'compare' %}
<section class="section{{ ' section--tint' if tint.next() }}">
  <div class="wrap">
    <header class="head reveal">
      <h2 class="h2">{{ s.heading }}</h2>
      {%- for p in s.intro %}{% for line in p | lines %}<p class="lead">{{ line }}</p>{% endfor %}{% endfor %}
    </header>
    <div class="ctable ctable--hl reveal" role="region" aria-label="{{ s.heading }}" tabindex="0">
      <table>
        <thead><tr><th scope="col"></th>{% for c in s.columns %}<th scope="col"{% if loop.first %} class="is-hl"{% endif %}>{{ c }}</th>{% endfor %}</tr></thead>
        <tbody>
          {%- for r in s.rows %}<tr><th scope="row">{{ r.label }}</th>{% for v in r.values %}<td{% if loop.first %} class="is-hl"{% endif %}>{{ v }}</td>{% endfor %}</tr>{% endfor %}
        </tbody>
      </table>
    </div>
    {%- for p in s.note %}<p class="note">{{ p | nl2br | safe }}</p>{% endfor %}
  </div>
</section>

{%- elif s.kind == 'steps' %}
<section class="section{{ ' section--tint' if tint.next() }}">
  <div class="wrap">
    <header class="head reveal">
      <h2 class="h2">{{ s.heading }}</h2>
      {%- for p in s.intro %}{% for line in p | lines %}<p class="lead">{{ line }}</p>{% endfor %}{% endfor %}
    </header>
    <ol class="steps">
      {%- for st in s.items %}
      <li class="step reveal" style="--d:{{ loop.index0 }}">
        {%- if st.image %}<div class="step__img"><img src="{{ st.image }}" alt="{{ st.title }}" loading="lazy" decoding="async"></div>{% endif %}
        <span class="step__n">{{ loop.index }}</span>
        <h3>{{ st.title }}</h3>
        <p>{{ st.text | nl2br | safe }}</p>
      </li>
      {%- endfor %}
    </ol>
    {%- for p in s.note %}<p class="note">{{ p | nl2br | safe }}</p>{% endfor %}
  </div>
</section>

{%- elif s.kind == 'prepost' %}
<section class="section{{ ' section--tint' if tint.next() }}">
  <div class="wrap">
    <header class="head reveal">
      <h2 class="h2">{{ s.heading }}</h2>
      {%- for p in s.intro %}{% for line in p | lines %}<p class="lead">{{ line }}</p>{% endfor %}{% endfor %}
    </header>
    <div class="pair">
      {%- for g in s.groups %}
      <div class="pair__card reveal" style="--d:{{ loop.index0 }}">
        <h3 class="h3">{{ g.label }}</h3>
        <ul class="bullets">{% for li in g.items %}<li>{{ li }}</li>{% endfor %}</ul>
      </div>
      {%- endfor %}
    </div>
    {%- for p in s.note %}<p class="note">{{ p | nl2br | safe }}</p>{% endfor %}
  </div>
</section>

{%- elif s.kind == 'journey' %}
<section class="section{{ ' section--tint' if tint.next() }}">
  <div class="wrap">
    <header class="head reveal"><h2 class="h2">{{ s.heading }}</h2></header>
    <ol class="journey">
      {%- set jc = ['violet','yellow','coral','mint'] %}
      {%- for it in s.items %}
      <li class="journey__step reveal" style="--d:{{ loop.index0 }}"><span class="journey__n c-{{ jc[loop.index0 % 4] }}">{{ loop.index }}</span><h3>{{ it.title }}</h3><p>{{ it.text }}</p></li>
      {%- endfor %}
    </ol>
    {%- for p in s.note %}<p class="note">{{ p | nl2br | safe }}</p>{% endfor %}
  </div>
</section>

{%- elif s.kind == 'awards' %}
{%- set aw = about.sections | whereKind("logos") %}
<section class="section{{ ' section--tint' if tint.next() }}">
  <div class="wrap">
    <header class="head reveal"><h2 class="h2">{{ s.heading }}</h2></header>
    <div class="reveal">{{ m.logoGrid(aw.logos) }}</div>
  </div>
</section>

{%- elif s.kind == 'quotes' %}
<section class="section reviews">
  <div class="wrap">
    <header class="head reveal">
      <h2 class="h2">{{ s.heading }}</h2>
      {%- for p in s.intro %}{% for line in p | lines %}<p class="lead">{{ line }}</p>{% endfor %}{% endfor %}
    </header>
    <div class="quotes quotes--{{ s.quotes.length }}">
      {%- for q in s.quotes %}
      <figure class="quote reveal" style="--d:{{ loop.index0 }}"><blockquote>“{{ q.quote }}”</blockquote><figcaption><strong>— {{ q.by }}</strong></figcaption></figure>
      {%- endfor %}
    </div>
    {%- for p in s.note %}<p class="note">{{ p | nl2br | safe }}</p>{% endfor %}
  </div>
</section>

{%- elif s.kind == 'cards' %}
<section class="section{{ ' section--tint' if tint.next() }}">
  <div class="wrap">
    <header class="head reveal">
      <h2 class="h2">{{ s.heading }}</h2>
      {%- for p in s.intro %}{% for line in p | lines %}<p class="lead">{{ line }}</p>{% endfor %}{% endfor %}
    </header>
    <div class="icards icards--{{ s.cards.length }}">
      {%- for c in s.cards %}
      <article class="icard reveal" style="--d:{{ loop.index0 }}">
        <figure class="icard__img"><img src="{{ c.image }}" alt="{{ c.title }}" loading="lazy" decoding="async"></figure>
        <h3>{{ c.title }}</h3>
        <ul class="bullets">{% for li in c.items %}<li>{{ li }}</li>{% endfor %}</ul>
      </article>
      {%- endfor %}
    </div>
    {%- for p in s.note %}<p class="note">{{ p | nl2br | safe }}</p>{% endfor %}
  </div>
</section>
{%- endif %}
{%- endfor %}
