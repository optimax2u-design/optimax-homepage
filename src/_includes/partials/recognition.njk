{#- Awards, insurance panels and media mentions (homepage + About) -#}
{%- set h = home -%}
<section class="section" id="recognition">
  <div class="wrap">
    <header class="head reveal">
      <p class="eyebrow">{{ h.recognition.eyebrow }}</p>
      <h2>{{ h.recognition.title }}</h2>
    </header>
    <div class="logos reveal">
      <h3>{{ h.recognition.awards_title }}</h3>
      <ul class="awards" data-carousel>
        {%- for a in h.recognition.awards %}
        <li class="award">
          <div class="award__logo">{% if a.logo %}<img src="{{ a.logo }}" alt="{{ a.name }}" loading="lazy" decoding="async">{% endif %}</div>
          <p class="award__name">{{ a.name }}</p>
        </li>
        {%- endfor %}
      </ul>
    </div>
    <div class="logos reveal">
      <h3>{{ h.recognition.panels_title }}</h3>
      <ul class="awards awards--panels">
        {%- for a in h.recognition.panels %}
        <li class="award award--panel">
          <div class="award__logo">{% if a.logo %}<img src="{{ a.logo }}" alt="{{ a.name }}" width="640" height="320" loading="lazy" decoding="async">{% endif %}</div>
          <p class="award__name">{{ a.name }}</p>
        </li>
        {%- endfor %}
      </ul>
    </div>
    <div class="logos reveal">
      <h3>{{ h.recognition.media_title }}</h3>
      <div class="marquee" aria-label="{{ h.recognition.media_title }}">
        <ul class="marquee__track">
          {%- for rep in [0,1] %}{% for m in h.recognition.media %}<li class="media"{% if rep %} aria-hidden="true"{% endif %}>{% if m.logo %}<img src="{{ m.logo }}" alt="{{ '' if rep else m.name }}" decoding="async">{% else %}{{ m.name }}{% endif %}</li>{% endfor %}{% endfor %}
        </ul>
      </div>
    </div>
  </div>
</section>
