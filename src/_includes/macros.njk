{#- Reusable building blocks for inner pages -#}

{%- macro crumbs(items) -%}
<nav class="crumbs" aria-label="Breadcrumb"><ol>
  <li><a href="/">Home</a></li>
  {%- for c in items %}<li>{% if c.url %}<a href="{{ c.url }}">{{ c.label }}</a>{% else %}<span aria-current="page">{{ c.label }}</span>{% endif %}</li>{% endfor %}
</ol></nav>
{%- endmacro -%}

{#- Page hero. h: {eyebrow,title,title_line2,subhead}; opts: {color,image,image_alt,badge_number,badge_label,crumbs,ctas,pills,compact} -#}
{%- macro phero(h, o) -%}
<section class="phero{% if o.compact %} phero--compact{% endif %}{% if not o.image %} phero--text{% endif %}">
  <div class="wrap phero__grid">
    <div class="phero__copy">
      {{ crumbs(o.crumbs) if o.crumbs }}
      <p class="eyebrow load" style="--d:0">{{ h.eyebrow }}</p>
      <h1 class="phero__title{% if h.title | length > 14 %} phero__title--long{% endif %} load" style="--d:1">{{ h.title }}{% if h.title_line2 %}<span>{{ h.title_line2 }}</span>{% endif %}</h1>
      {%- if h.subhead %}<p class="phero__sub load" style="--d:2">{{ h.subhead }}</p>{% endif %}
      {%- if o.ctas %}
      <div class="hero__ctas load" style="--d:3">
        {%- for c in o.ctas %}<a href="{{ c.url }}" class="btn btn--{{ c.style or 'primary' }} btn--lg"{% if c.external %} target="_blank" rel="noopener"{% endif %}>{{ c.label | safe }}</a>{% endfor %}
      </div>
      {%- endif %}
      {%- if o.pills %}<ul class="pills load" style="--d:4">{% for p in o.pills %}<li class="pill">{{ p }}</li>{% endfor %}</ul>{% endif %}
    </div>
    {%- if o.image %}
    <div class="phero__visual c-{{ o.color or 'violet' }} load" style="--d:2">
      <div class="phero__card"><img src="{{ o.image }}" alt="{{ o.image_alt or '' }}" width="900" height="700" fetchpriority="high" decoding="async"{% if o.image_fit %} style="object-fit:{{ o.image_fit }}"{% endif %}></div>
      {%- if o.badge_number %}
      <div class="badge phero__badge" role="img" aria-label="{{ o.badge_number }} {{ o.badge_label }}">
        <svg class="badge__ring" viewBox="0 0 200 200" aria-hidden="true"><circle cx="100" cy="100" r="88"/></svg>
        <span class="badge__num">{{ o.badge_number }}</span>
        <span class="badge__label">{{ o.badge_label }}</span>
      </div>
      {%- endif %}
    </div>
    {%- endif %}
  </div>
</section>
{%- endmacro -%}

{%- macro tiles(items) -%}
<section class="stats" aria-label="Key facts">
  <div class="wrap stats__grid">
    {%- for s in items %}
    <div class="tile c-{{ s.color }} reveal" style="--d:{{ loop.index0 }}">
      <span class="tile__value tile__value--sm">{{ s.value }}</span>
      <span class="tile__label">{{ s.label }}</span>
    </div>
    {%- endfor %}
  </div>
</section>
{%- endmacro -%}

{%- macro tcard(t, groups) -%}
<a class="tcard c-{{ t.color }} reveal" href="/{{ t.slug }}/">
  {%- if groups %}{% for g in groups %}{% if g.id == t.group %}<span class="tcard__group">{{ g.title }}</span>{% endif %}{% endfor %}{% endif %}
  <span class="tcard__name">{{ t.short }}</span>
  <span class="tcard__sum">{{ t.card.summary }}</span>
  <span class="tcard__best"><b>Best for</b> {{ t.card.suited }}</span>
  <span class="tcard__meta"><span>{% if "0123456789".indexOf(t.card.age[0]) > -1 %}Age {% endif %}{{ t.card.age }}</span></span>
  <span class="tcard__go" aria-hidden="true">→</span>
</a>
{%- endmacro -%}

{%- macro doccard(d, branchesData) -%}
<a class="doc doc--link" href="/doctor/{{ d.slug }}/" data-branches="{{ d.branches | join(' ') }}" data-langs="{{ d.languages | join('|') }}">
  <div class="doc__photo c-{{ d.color }}"><img src="{{ d.photo }}" alt="Portrait of {{ d.name }}" width="600" height="750" loading="lazy" decoding="async"></div>
  <div class="doc__cap">
    <strong>{{ d.name }}</strong>
    <span class="doc__title">{{ d.title }}</span>
    <span>{{ d.credentials }}</span>
    {%- if branchesData %}<span class="doc__where">📍 {% for s in d.branches %}{% set b = s | branchBySlug(branchesData) %}{{ b.name if b }}{{ ', ' if not loop.last }}{% endfor %}</span>{% endif %}
  </div>
</a>
{%- endmacro -%}

{%- macro reviewsBand(rv, siteData, title) -%}
<section class="section reviews">
  <div class="wrap">
    <header class="head reveal">
      <p class="eyebrow">{{ rv.eyebrow }}</p>
      <h2>{{ title or rv.title }}</h2>
      <p class="reviews__rating"><span class="stars" aria-hidden="true">★★★★★</span> {{ rv.rating_text }}</p>
    </header>
    <div class="quotes" data-carousel>
      {%- for r in rv.items | batch(3) | first %}
      <figure class="quote reveal" style="--d:{{ loop.index0 }}">
        <blockquote>“{{ r.quote }}”</blockquote>
        <figcaption>{% if r.photo %}<img class="avatar avatar--photo" src="{{ r.photo }}" alt="" width="44" height="44" loading="lazy" decoding="async">{% else %}<span class="avatar" aria-hidden="true">{{ r.name | first }}</span>{% endif %}<span><strong>{{ r.name }}</strong><span class="rating" role="img" aria-label="Rated 5 out of 5 stars">{% for i in range(5) %}<svg viewBox="0 0 20 20" aria-hidden="true" class="on"><path d="M10 1.6l2.6 5.3 5.8.8-4.2 4.1 1 5.8L10 14.9l-5.2 2.7 1-5.8L1.6 7.7l5.8-.8z"/></svg>{% endfor %}</span></span></figcaption>
      </figure>
      {%- endfor %}
    </div>
    <a class="textlink" href="{{ rv.link.url }}" target="_blank" rel="noopener">{{ rv.link.label }} <span aria-hidden="true">→</span></a>
  </div>
</section>
{%- endmacro -%}

{%- macro faqList(items, idp) -%}
<div class="faq">
  {%- for f in items %}
  <details class="faq__item"{% if idp and loop.first %} open{% endif %}>
    <summary><span>{{ f.q }}</span><i aria-hidden="true"></i></summary>
    <div class="faq__a"><p>{{ f.a }}</p></div>
  </details>
  {%- endfor %}
</div>
{%- endmacro -%}
