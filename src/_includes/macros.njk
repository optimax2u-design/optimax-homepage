{#- Reusable building blocks. All text comes from the data files (copied word-for-word from the live site).
    One markup for every screen size — layout changes are done in CSS only. -#}

{%- macro crumbs(items) -%}
<nav class="crumbs" aria-label="Breadcrumb"><ol>
  <li><a href="/">Home</a></li>
  {%- for c in items %}<li>{% if c.url %}<a href="{{ c.url }}">{{ c.label }}</a>{% else %}<span aria-current="page">{{ c.label }}</span>{% endif %}</li>{% endfor %}
</ol></nav>
{%- endmacro -%}

{#- Page header. h: {eyebrow?, title, sub:[...], buttons:[{label,href,style}], image, image_alt} -#}
{%- macro phero(h, crumbItems) -%}
<section class="phero{% if not h.image %} phero--text{% endif %}">
  <div class="wrap phero__grid">
    <div class="phero__copy">
      {{ crumbs(crumbItems) if crumbItems }}
      {%- if h.eyebrow %}<p class="eyebrow load" style="--d:0">{{ h.eyebrow }}</p>{% endif %}
      <h1 class="phero__title load" style="--d:1">{{ h.title | nl2br | safe }}</h1>
      {%- for s in h.sub %}<p class="phero__sub load" style="--d:2">{{ s | nl2br | safe }}</p>{% endfor %}
      {%- if h.buttons and h.buttons.length %}
      <div class="ctas load" style="--d:3">
        {%- for b in h.buttons %}<a href="{{ b.href }}" class="btn btn--{{ b.style or 'primary' }} btn--lg"{% if b.href.startsWith('http') %} target="_blank" rel="noopener"{% endif %}>{{ b.label }}</a>{% endfor %}
      </div>
      {%- endif %}
    </div>
    {%- if h.image %}
    <div class="phero__media load" style="--d:2"><img src="{{ h.image }}" alt="{{ h.image_alt or '' }}" width="1200" height="800" fetchpriority="high" decoding="async"></div>
    {%- endif %}
  </div>
</section>
{%- endmacro -%}

{#- Renders a list of content items: sub (small heading), p, list, img, btn, table -#}
{%- macro items(list, opts) -%}
{%- for it in list %}
{%- if it.t == 'sub' %}<h3 class="sub"{% if it.id %} id="{{ it.id }}"{% endif %}>{{ it.v | nl2br | safe }}</h3>
{%- elif it.t == 'p' %}
  {%- if it.v | isButtonText %}<p><a class="btn btn--primary" href="{{ it.v | buttonHref }}">{{ it.v | buttonLabel }}</a></p>
  {%- else %}{% for line in it.v | lines %}<p{% if it.v | isNote %} class="note"{% endif %}>{{ line }}</p>{% endfor %}{% endif %}
{%- elif it.t == 'list' %}<ul class="bullets">{% for li in it.v %}<li>{{ li | nl2br | safe }}</li>{% endfor %}</ul>
{%- elif it.t == 'img' and not (opts and opts.noImages) %}<figure class="fig"><img src="{{ it.v }}" alt="{{ it.alt or '' }}" loading="lazy" decoding="async"></figure>
{%- elif it.t == 'btn' %}<p><a class="btn btn--primary" href="{{ it.href | fixHref }}"{% if it.href.startsWith('http') and not it.href.includes('optimaxeyespecialist.com') %} target="_blank" rel="noopener"{% endif %}>{{ it.v }}</a></p>
{%- elif it.t == 'table' %}{{ table(it.v) }}
{%- endif %}
{%- endfor %}
{%- endmacro -%}

{%- macro imagesOf(list) -%}{%- for it in list %}{% if it.t == 'img' %}<figure class="fig"><img src="{{ it.v }}" alt="{{ it.alt or '' }}" loading="lazy" decoding="async"></figure>{% endif %}{% endfor %}{%- endmacro -%}

{%- macro table(rows) -%}
<div class="ctable" role="region" tabindex="0"><table>
  {%- for r in rows %}<tr>{% for c in r %}{% if loop.first %}<th scope="row">{{ c | nl2br | safe }}</th>{% else %}<td>{{ c | nl2br | safe }}</td>{% endif %}{% endfor %}</tr>{% endfor %}
</table></div>
{%- endmacro -%}

{#- Section with heading + content; images go to the side column -#}
{%- macro textSection(heading, list, tint, idAttr) -%}
{%- set hasImg = list | hasImages -%}
<section class="section{{ ' section--tint' if tint }}"{% if idAttr %} id="{{ idAttr }}"{% endif %}>
  <div class="wrap{{ ' split split--media' if hasImg }}">
    <div class="prose-block reveal">
      <h2 class="h2">{{ heading | nl2br | safe }}</h2>
      {{ items(list, {noImages: true}) }}
    </div>
    {%- if hasImg %}<div class="side-media reveal" style="--d:1">{{ imagesOf(list) }}</div>{% endif %}
  </div>
</section>
{%- endmacro -%}

{%- macro logoGrid(logos) -%}
<ul class="logogrid">
  {%- for l in logos %}<li><img src="{{ l.image }}" alt="{{ l.name }}" loading="lazy" decoding="async"></li>{% endfor %}
</ul>
{%- endmacro -%}

{%- macro faqList(questions, openFirst) -%}
<div class="faq">
  {%- for f in questions %}
  <details class="faq__item"{% if openFirst and loop.first %} open{% endif %}>
    <summary><span>{{ f.q }}</span><i aria-hidden="true"></i></summary>
    <div class="faq__a">
      {%- for a in f.a %}
      {%- if a.t == 'list' %}<ul class="bullets">{% for li in a.v %}<li>{{ li | nl2br | safe }}</li>{% endfor %}</ul>
      {%- elif a.t == 'img' %}<figure class="fig"><img src="{{ a.v }}" alt="{{ a.alt or '' }}" loading="lazy" decoding="async"></figure>
      {%- else %}<p>{{ a.v | nl2br | safe }}</p>{% endif %}
      {%- endfor %}
    </div>
  </details>
  {%- endfor %}
</div>
{%- endmacro -%}

{%- macro doccard(d) -%}
<a class="doc doc--link" href="/doctor/{{ d.slug }}/" data-branches="{{ d.branches | join(' ') }}" data-langs="{{ d.languages | join('|') }}">
  <div class="doc__photo c-{{ d.color }}"><img src="{{ d.photo }}" alt="{{ d.name }}" width="600" height="750" loading="lazy" decoding="async"></div>
  <div class="doc__cap"><strong>{{ d.name }}</strong><span>{{ d.credentials }}</span></div>
</a>
{%- endmacro -%}
