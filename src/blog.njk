---
permalink: /blog/
layout: layouts/base.njk
hide_booking: true
title: "Optimax Blog | Eye Care News, LASIK & Vision Tips Malaysia"
description: "Eye care news, LASIK and vision tips from Optimax Eye Specialist."
---
{#- Blog list — posts, titles, categories, excerpts and featured images from optimaxeyespecialist.com/blog/ -#}
{%- import "macros.njk" as m -%}

{{ m.phero({title: blog.heading}, [{label: "Blog"}]) }}

<section class="section section--flush">
  <div class="wrap">
    <div class="posts">
      {%- for p in blog.posts %}
      <a class="post reveal" href="/{{ p.slug }}/" style="--d:{{ loop.index0 % 3 }}">
        <figure class="post__img"><img src="{{ p.image }}" alt="{{ p.title }}" width="768" height="513" loading="lazy" decoding="async"></figure>
        <p class="post__meta">{% for c in p.categories %}<span class="post__cat">{{ c }}</span>{% endfor %}</p>
        <h2 class="post__title">{{ p.title }}</h2>
        <p class="post__date">{{ p.date | niceDate }}</p>
        <p class="post__excerpt">{{ p.excerpt }}</p>
      </a>
      {%- endfor %}
    </div>
  </div>
</section>
