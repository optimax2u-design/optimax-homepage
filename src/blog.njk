---
permalink: /blog/
layout: layouts/base.njk
eleventyComputed:
  title: "{{ blog.seo_title }}"
  description: "{{ blog.seo_description }}"
---
{%- import "macros.njk" as m -%}
{%- set posts = blog.posts | sort(true, false, "date") -%}
{%- set cats = blog.posts | pluck("categories") | uniq -%}
{%- set lead = posts[0] -%}

{{ m.phero(blog, { compact: true, crumbs: [{label: "Blog"}] }) }}

<section class="section section--flush">
  <div class="wrap">
    <a class="feature c-{{ lead.color }} reveal" href="/{{ lead.slug }}/">
      <div class="feature__cover cover c-{{ lead.color }}"><span aria-hidden="true">{{ lead.emoji }}</span></div>
      <div class="feature__body">
        <p class="post__meta"><span class="post__cat">{{ lead.categories[0] }}</span> · {{ lead.date | niceDate }}</p>
        <h2>{{ lead.title }}</h2>
        <p>{{ lead.excerpt }}</p>
        <span class="textlink">Read article <span aria-hidden="true">→</span></span>
      </div>
    </a>

    <div class="fchips fchips--center reveal" role="group" aria-label="Filter by topic" data-post-filter>
      <button type="button" class="fchip" aria-pressed="true" data-cat="">All topics</button>
      {%- for c in cats %}<button type="button" class="fchip" aria-pressed="false" data-cat="{{ c }}">{{ c }}</button>{% endfor %}
    </div>

    <div class="posts">
      {%- for p in posts %}{% if not loop.first %}
      <a class="post reveal" href="/{{ p.slug }}/" data-cats="{{ p.categories | join('|') }}" style="--d:{{ loop.index0 % 3 }}">
        <div class="cover c-{{ p.color }}"><span aria-hidden="true">{{ p.emoji }}</span></div>
        <p class="post__meta"><span class="post__cat">{{ p.categories[0] }}</span> · {{ p.date | niceDate }}</p>
        <h3>{{ p.title }}</h3>
        <p>{{ p.excerpt }}</p>
      </a>
      {%- endif %}{% endfor %}
    </div>
  </div>
</section>
