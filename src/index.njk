---
permalink: /index.html
layout: layouts/base.njk
---
{%- set h = home -%}

{# 3. Hero #}
<section class="hero" id="top">
  <div class="wrap hero__grid">
    <div class="hero__copy">
      <p class="eyebrow load" style="--d:0">{{ h.hero.eyebrow }}</p>
      <h1 class="hero__title load" style="--d:1">{{ h.hero.headline }}<span>{{ h.hero.headline_line2 }}</span></h1>
      <p class="hero__sub load" style="--d:2">{{ h.hero.subhead }}</p>
      <div class="hero__ctas load" style="--d:3">
        <a href="{{ h.hero.primary_cta.url }}" class="btn btn--primary btn--lg">{{ h.hero.primary_cta.label }}</a>
        <a href="{{ h.hero.secondary_cta.url }}" class="btn btn--ghost btn--lg">{{ h.hero.secondary_cta.label }} <span aria-hidden="true">→</span></a>
      </div>
      <ul class="pills load" style="--d:4" aria-label="Why patients trust us">
        {%- for p in h.hero.trust_pills %}<li class="pill">{{ p.text }}</li>{% endfor %}
      </ul>
    </div>
    <div class="hero__visual{% if h.hero.image_cutout %} hero__visual--cutout{% endif %} load" style="--d:2">
      {%- if h.hero.image_cutout %}
      <span class="hero__glow" aria-hidden="true"></span>
      <picture class="hero__cutout">
        {%- if h.hero.image_mobile %}<source media="(max-width: 640px)" srcset="{{ h.hero.image_mobile }}">{% endif %}
        <img src="{{ h.hero.image }}" alt="{{ h.hero.image_alt }}" width="1100" height="1090" fetchpriority="high" decoding="async">
      </picture>
      {%- else %}
      <div class="hero__photo">
        <img src="{{ h.hero.image }}" alt="{{ h.hero.image_alt }}" width="1200" height="1400" fetchpriority="high">
      </div>
      {%- endif %}
      <div class="badge" role="img" aria-label="{{ h.hero.badge_number }} {{ h.hero.badge_label }}">
        <svg class="badge__ring" viewBox="0 0 200 200" aria-hidden="true"><circle cx="100" cy="100" r="88"/></svg>
        <span class="badge__num">{{ h.hero.badge_number }}</span>
        <span class="badge__label">{{ h.hero.badge_label }}</span>
      </div>
      <span class="blob blob--y" aria-hidden="true"></span>
      <span class="blob blob--m" aria-hidden="true"></span>
    </div>
  </div>
  <p class="wrap footnote">{{ h.hero.footnote }}</p>
</section>

{# 4. Stats #}
<section class="stats" aria-label="Optimax at a glance">
  <div class="wrap stats__grid">
    {%- for s in h.stats %}
    <div class="tile c-{{ s.color }} reveal" style="--d:{{ loop.index0 }}">
      <span class="tile__value">{{ s.value }}</span>
      <span class="tile__label">{{ s.label }}</span>
    </div>
    {%- endfor %}
  </div>
</section>

{# 5. Treatment finder #}
<section class="section finder" id="finder">
  <div class="wrap">
    <header class="head reveal">
      <p class="eyebrow">{{ h.finder.eyebrow }}</p>
      <h2>{{ h.finder.title }}</h2>
      <p class="lead">{{ h.finder.intro }}</p>
    </header>
    <div class="finder__box reveal">
      <div class="finder__options" role="radiogroup" aria-label="Choose your concern">
        {%- for o in h.finder.options %}
        <button type="button" role="radio" aria-checked="{{ 'true' if loop.first else 'false' }}" tabindex="{{ '0' if loop.first else '-1' }}" class="chip c-{{ o.color }}" data-id="{{ o.id }}">
          <span class="chip__emoji" aria-hidden="true">{{ o.emoji }}</span>{{ o.concern }}
        </button>
        {%- endfor %}
      </div>
      {%- set f = h.finder.options[0] %}
      <div class="finder__result c-{{ f.color }}" aria-live="polite" id="finder-result">
        <p class="finder__kicker">We'd suggest starting with</p>
        <h3 class="finder__rec" data-f="recommended">{{ f.recommended }}</h3>
        <p data-f="summary">{{ f.summary }}</p>
        <p class="finder__alt-title">Other options to discuss</p>
        <ul class="finder__alts" data-f="alternatives">{% for a in f.alternatives %}<li>{{ a }}</li>{% endfor %}</ul>
        <div class="finder__actions">
          <a href="#book" class="btn btn--dark" data-f="book">Book a free eye check</a>
          <a href="{{ f.url }}" class="btn btn--ghost" data-f="url">Learn more <span aria-hidden="true">→</span></a>
        </div>
        <p class="finder__note">{{ h.finder.note }}</p>
      </div>
    </div>
  </div>
  <script type="application/json" id="finder-data">{{ h.finder.options | dump | safe }}</script>
</section>

{# 6. Treatments #}
<section class="section" id="treatments">
  <div class="wrap">
    <header class="head reveal">
      <p class="eyebrow">{{ h.treatments.eyebrow }}</p>
      <h2>{{ h.treatments.title }}</h2>
    </header>
    <div class="cards" data-carousel>
      {%- for c in h.treatments.cards %}
      <article class="card c-{{ c.color }} reveal" style="--d:{{ loop.index0 }}">
        <div class="card__body">
          <h3>{{ c.title }}</h3>
          <p>{{ c.text }}</p>
          <ul class="tags">{% for i in c.items %}{% set t = i | findTreatment(treatments.list) %}<li>{% if t %}<a href="/{{ t.slug }}/">{{ i }}</a>{% else %}{{ i }}{% endif %}</li>{% endfor %}</ul>
          <a href="{{ c.url }}" class="card__link" aria-label="Learn more about {{ c.title }}">Learn more <span aria-hidden="true">→</span></a>
        </div>
        <div class="card__media"><img src="{{ c.image }}" alt="{{ c.image_alt or '' }}" width="900" height="700" loading="lazy" decoding="async"></div>
      </article>
      {%- endfor %}
    </div>
  </div>
</section>

{# 7. Why Optimax #}
<section class="section section--tint" id="why">
  <div class="wrap">
    <header class="head reveal">
      <p class="eyebrow">{{ h.why.eyebrow }}</p>
      <h2>{{ h.why.title }}</h2>
    </header>
    <div class="why">
      {%- for w in h.why.items %}
      <article class="why__item c-{{ w.color }} reveal" style="--d:{{ loop.index0 }}">
        <div class="why__media"><img src="{{ w.image }}" alt="{{ w.image_alt or '' }}" width="720" height="720" loading="lazy" decoding="async"></div>
        <span class="why__num">{{ loop.index }}</span>
        <h3>{{ w.title }}</h3>
        <p>{{ w.text }}</p>
      </article>
      {%- endfor %}
    </div>
  </div>
</section>

{# 8. Journey #}
<section class="section" id="journey">
  <div class="wrap">
    <header class="head reveal">
      <p class="eyebrow">{{ h.journey.eyebrow }}</p>
      <h2>{{ h.journey.title }}</h2>
    </header>
    <ol class="journey">
      {%- set jc = ['violet','yellow','coral','mint'] %}
      {%- for s in h.journey.steps %}
      <li class="journey__step reveal" style="--d:{{ loop.index0 }}">
        <span class="journey__n c-{{ jc[loop.index0 % 4] }}">{{ loop.index }}</span>
        <h3>{{ s.title }}</h3>
        <p>{{ s.text }}</p>
      </li>
      {%- endfor %}
    </ol>
  </div>
</section>

{# 9. Doctors #}
<section class="section section--tint" id="doctors">
  <div class="wrap">
    <header class="head head--row reveal">
      <div>
        <p class="eyebrow">{{ h.doctors.eyebrow }}</p>
        <h2>{{ h.doctors.title }}</h2>
        <p class="lead">{{ h.doctors.intro }}</p>
      </div>
      <div class="scroller__ctrl">
        <button type="button" class="round" data-scroll="-1" aria-label="Previous doctors">←</button>
        <button type="button" class="round" data-scroll="1" aria-label="Next doctors">→</button>
      </div>
    </header>
  </div>
  <div class="scroller" id="doctor-scroller" tabindex="0" aria-label="Doctors" data-carousel>
    {%- for d in doctors.list %}
    <a class="doc doc--link" href="/doctor/{{ d.slug }}/">
      <div class="doc__photo c-{{ d.color }}"><img src="{{ d.photo }}" alt="Portrait of {{ d.name }}" width="600" height="750" loading="lazy" decoding="async"></div>
      <div class="doc__cap"><strong>{{ d.name }}</strong><span>{{ d.credentials }}</span></div>
    </a>
    {%- endfor %}
  </div>
  <div class="wrap"><a class="textlink" href="{{ h.doctors.link.url }}">{{ h.doctors.link.label }} <span aria-hidden="true">→</span></a></div>
</section>

{# 10. Reviews #}
<section class="section reviews" id="reviews">
  <div class="wrap">
    <header class="head reveal">
      <p class="eyebrow">{{ h.reviews.eyebrow }}</p>
      <h2>{{ h.reviews.title }}</h2>
      <p class="reviews__rating"><span class="stars" aria-hidden="true">★★★★★</span> {{ h.reviews.rating_text }}</p>
    </header>
    <div class="quotes" data-carousel>
      {%- for r in h.reviews.items %}
      <figure class="quote reveal" style="--d:{{ loop.index0 % 3 }}">
        <blockquote>“{{ r.quote }}”</blockquote>
        <figcaption>{% if r.photo %}<img class="avatar avatar--photo" src="{{ r.photo }}" alt="" width="44" height="44" loading="lazy" decoding="async">{% else %}<span class="avatar" aria-hidden="true">{{ r.name | first }}</span>{% endif %}<span><strong>{{ r.name }}</strong>{% set rt = r.rating or 5 %}<span class="rating" role="img" aria-label="Rated {{ rt }} out of 5 stars">{% for i in range(5) %}<svg viewBox="0 0 20 20" aria-hidden="true" class="{{ 'on' if i < rt else 'off' }}"><path d="M10 1.6l2.6 5.3 5.8.8-4.2 4.1 1 5.8L10 14.9l-5.2 2.7 1-5.8L1.6 7.7l5.8-.8z"/></svg>{% endfor %}</span></span></figcaption>
      </figure>
      {%- endfor %}
    </div>
    <a class="textlink" href="{{ h.reviews.link.url }}" target="_blank" rel="noopener">{{ h.reviews.link.label }} <span aria-hidden="true">→</span></a>
  </div>
</section>

{# 11. Recognition #}
{% include "partials/recognition.njk" %}
