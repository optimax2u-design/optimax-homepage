---
permalink: /about-us/
layout: layouts/base.njk
hide_booking: true
eleventyComputed:
  title: "{{ pages.about.title }}"
  description: "{{ pages.about.description }}"
---
{#- About — content word-for-word from optimaxeyespecialist.com/about-us-2/ (src/_data/pages/about.json) -#}
{%- import "macros.njk" as m -%}
{%- set P = pages.about -%}

{{ m.phero({title: P.hero.title, sub: P.hero.sub, image: P.hero.image, buttons: [{label: P.hero.btn.label, href: "/#book"}]}, [{label: "About Us"}]) }}

{%- for s in P.sections %}
{%- if s.kind == 'logos' %}
<section class="section{{ ' section--tint' if loop.index0 % 2 == 0 }}" id="{{ 'awards' if 'AWARD' in s.heading | upper else 'insurance' }}">
  <div class="wrap">
    <header class="head reveal">
      <h2 class="h2">{{ s.heading }}</h2>
      {%- for p in s.text %}<p class="lead">{{ p }}</p>{% endfor %}
    </header>
    <div class="reveal">{{ m.logoGrid(s.logos) }}</div>
  </div>
</section>
{%- else %}
{{ m.textSection(s.heading, s.items, loop.index0 % 2 == 0) }}
{%- endif %}
{%- endfor %}
