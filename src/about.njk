---
permalink: /about-us/
layout: layouts/base.njk
eleventyComputed:
  title: "{{ about.seo_title }}"
  description: "{{ about.seo_description }}"
---
{%- import "macros.njk" as m -%}
{%- set a = about -%}

{{ m.phero(a.hero, { color: "sky", image: a.hero.image, image_alt: a.hero.image_alt, image_fit: "contain", badge_number: "31+", badge_label: "years of care", crumbs: [{label: "About"}], ctas: [{label: "Book a free eye check", url: "#book"}, {label: "Meet our doctors →", url: "/doctor/", style: "ghost"}], pills: ["Since 1995", "Listed on Bursa Malaysia", "ISO 9001 / MHTC"] }) }}

{{ m.tiles(a.stats) }}

<section class="section">
  <div class="wrap split split--media">
    <div class="reveal">
      <p class="eyebrow">{{ a.story.eyebrow }}</p>
      <h2 class="h2">{{ a.story.title }}</h2>
      {%- for p in a.story.paragraphs %}<p class="lead">{{ p }}</p>{% endfor %}
    </div>
    <div class="mediacard c-violet reveal" style="--d:1"><img src="{{ a.story.image }}" alt="{{ a.story.image_alt }}" width="720" height="720" loading="lazy" decoding="async"></div>
  </div>
</section>

<section class="section section--tint">
  <div class="wrap">
    <header class="head reveal">
      <p class="eyebrow">{{ a.timeline.eyebrow }}</p>
      <h2>{{ a.timeline.title }}</h2>
      <p class="lead">{{ a.timeline.intro }}</p>
    </header>
    <ol class="tline">
      {%- for i in a.timeline.items %}
      <li class="tline__item c-{{ i.color }} reveal" style="--d:{{ loop.index0 }}">
        <span class="tline__era">{{ i.era }}</span>
        <h3>{{ i.title }}</h3>
        <p>{{ i.text }}</p>
      </li>
      {%- endfor %}
    </ol>
    <a class="textlink" href="/treatments/">See today's treatments <span aria-hidden="true">→</span></a>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <header class="head reveal">
      <p class="eyebrow">{{ a.people.eyebrow }}</p>
      <h2>{{ a.people.title }}</h2>
      <p class="lead">{{ a.people.text }}</p>
    </header>
    <div class="icards icards--3">
      {%- for i in a.people.items %}
      <article class="icard c-{{ i.color }} reveal" style="--d:{{ loop.index0 }}"><span class="icard__emoji" aria-hidden="true">{{ i.emoji }}</span><h3>{{ i.title }}</h3><p>{{ i.text }}</p></article>
      {%- endfor %}
    </div>
  </div>
</section>

<section class="section section--flush">
  <div class="wrap">
    <div class="banner c-yellow reveal">
      <div>
        <p class="eyebrow">{{ a.warranty.eyebrow }}</p>
        <h2>{{ a.warranty.title }}</h2>
        <p>{{ a.warranty.text }}</p>
      </div>
      <a href="#book" class="btn btn--dark btn--lg">Talk to our team</a>
    </div>
  </div>
</section>

<section class="section section--tint">
  <div class="wrap">
    <header class="head reveal">
      <p class="eyebrow">{{ home.why.eyebrow }}</p>
      <h2>{{ home.why.title }}</h2>
    </header>
    <div class="why">
      {%- for w in home.why.items %}
      <article class="why__item c-{{ w.color }} reveal" style="--d:{{ loop.index0 }}">
        <div class="why__media"><img src="{{ w.image }}" alt="{{ w.image_alt or '' }}" width="720" height="720" loading="lazy" decoding="async"></div>
        <span class="why__num">{{ loop.index }}</span>
        <h3>{{ w.title }}</h3>
        <p>{{ w.text }}</p>
      </article>
      {%- endfor %}
    </div>
  </div>
</section>

{% include "partials/recognition.njk" %}
