---
permalink: /faqs/
layout: layouts/base.njk
hide_booking: true
eleventyComputed:
  title: "{{ pages.faqs.title }}"
  description: "{{ pages.faqs.description }}"
---
{#- FAQs — content word-for-word from optimaxeyespecialist.com/faqs/ (src/_data/pages/faqs.json) -#}
{%- import "macros.njk" as m -%}
{%- set P = pages.faqs -%}

{{ m.phero({title: "FAQs"}, [{label: "FAQs"}]) }}

<section class="section section--flush">
  <div class="wrap faqs">
    <nav class="faqs__nav" aria-label="FAQ topics">
      {%- for g in P.groups %}<a href="#topic-{{ loop.index }}" class="faqs__link">{{ g.heading }}</a>{% endfor %}
    </nav>
    <div class="faqs__body">
      {%- for g in P.groups %}
      <section class="faqs__group reveal" id="topic-{{ loop.index }}">
        <h2 class="h3">{{ g.heading }}</h2>
        {%- if g.questions.length %}{{ m.faqList(g.questions, loop.first) }}{% endif %}
        {%- if g.items.length %}<div class="prose">{{ m.items(g.items) }}</div>{% endif %}
      </section>
      {%- endfor %}
    </div>
  </div>
</section>

<script type="application/ld+json">{{ P.groups | faqSchema | safe }}</script>
